# ==============================================================================
# ResumeForge AI SaaS — Environment Variables Template (.env)
# ==============================================================================

# Django Core
DEBUG=False
SECRET_KEY=your-super-secret-django-key-replace-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Neon Serverless PostgreSQL Database Connection String
# Get this from: https://console.neon.tech/app/projects -> Connection Details
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Groq LLM API Key (For ATS Semantic Scoring & AI Mock Interviews)
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Celery (Set to True for single Render dyno without separate Redis instance)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0

# Razorpay Payment Gateway (Optional for subscriptions)
RAZORPAY_KEY_ID=rzp_test_your_id
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# CSRF Trusted Origins for Render
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.render.com
